<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>fun.commons</groupId>
    <artifactId>token-route</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>token-route</name>
    <description>通用 API 路由服务：路由决议 + 条目容量治理（Redis only）</description>

    <modules>
        <module>token-route-app</module>
        <module>token-route-sdk</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- fwk4j 三件（web/accesstoken/redis）走 jitpack，对齐 benefit4j / token-gateway 基线 -->
        <framework4j.version>v1.5.1</framework4j.version>
        <groovy.version>4.0.28</groovy.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <jacoco.version>0.8.13</jacoco.version>
    </properties>

    <repositories>
        <repository>
            <id>aliyunmaven</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- 07_实施计划 §覆盖率门槛：总行 ≥80% / 分支 ≥70%；
                         TrCode / 脚本引擎核心 线 ≥90%（退避与租约计算在 Lua 中，无对应 Java Util）。
                         failsafe IT 与 surefire 单测写同一 jacoco.exec，门槛按全量口径核验；
                         无 Docker 环境跳过门槛���-Djacoco.skip=true -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>fun.commons.tokenroute.common.TrCode</include>
                                        <include>fun.commons.tokenroute.engine.TrScriptEngine</include>
                                        <include>fun.commons.tokenroute.engine.TrScriptFunctions</include>
                                        <include>fun.commons.tokenroute.engine.TrScriptLoader</include>
                                        <include>fun.commons.tokenroute.engine.TrMethodBlacklistCustomizer</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
