<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fun.commons</groupId>
        <artifactId>token-route</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>token-route-starter</artifactId>
    <name>token-route-starter</name>
    <description>token-route 嵌入式核心 SDK（starter）：路由引擎 + 亲和 + 状态机 + 容量治理，自动装配进宿主进程直调（零网络跳）；tr.tables 种子随宿主配置。不含 web/actuator/鉴权面。</description>

    <dependencies>
        <!-- Spring Boot 自动装配（@AutoConfiguration / properties / ObjectProvider） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- 请求 DTO @NotBlank 校验注解（api only，不拖 web） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- fwk4j-web：ApiException / 错误码（仅异常类型，GlobalExceptionHandler 不在本库激活面内；
             宿主若自行启用 fwk4j-web 全局异常处理须自备 spring-jdbc，见 funcommons/framework4j#19） -->
        <dependency>
            <groupId>com.github.funcommons.framework4j</groupId>
            <artifactId>framework4j-web</artifactId>
            <version>${framework4j.version}</version>
        </dependency>
        <!-- fwk4j redis：MultiRedis（宿主提供 MultiRedisManager bean；传递 redisson-spring-boot-starter，
             其 Boot/Redisson 自动装配由宿主按需排除——族内惯例，见 app TrRouteApplication 排除链） -->
        <dependency>
            <groupId>com.github.funcommons.framework4j</groupId>
            <artifactId>framework4j-redis</artifactId>
            <version>${framework4j.version}</version>
        </dependency>
        <!-- FEED 拉取 / 事件 JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Groovy 脚本引擎（05 号：沙箱） -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>${groovy.version}</version>
        </dependency>
        <!-- SLI 指标（宿主无 MeterRegistry 时自动 noop） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- docker.io 不可达：禁用 Ryuk 守护容器（@Container 生命周期由 JUnit 管理） -->
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>
            <!-- IT 走 failsafe（*IT 命名 + @EnabledIfSystemProperty("tr.it") 门控）：
                 mvn verify -Dtr.it=true 启用；jacoco argLine 两阶段共用 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
