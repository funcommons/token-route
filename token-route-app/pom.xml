<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fun.commons</groupId>
        <artifactId>token-route</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>token-route-app</artifactId>
    <name>token-route-app</name>
    <description>token-route 服务本体（契约面 + ops 面 + 决议引擎）</description>

    <dependencies>
        <!-- fwk4j-web 对 starter-web 为 optional，应用显式引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- fwk4j web：ApiResponse 信封 / ApiException / GlobalExceptionHandler -->
        <dependency>
            <groupId>com.github.funcommons.framework4j</groupId>
            <artifactId>framework4j-web</artifactId>
            <version>${framework4j.version}</version>
        </dependency>
        <!-- fwk4j accesstoken：jwt 鉴权模式（只验不签，@RequiresToken / AccessTokenValidationStrategy） -->
        <dependency>
            <groupId>com.github.funcommons.framework4j</groupId>
            <artifactId>framework4j-accesstoken</artifactId>
            <version>${framework4j.version}</version>
        </dependency>
        <!-- fwk4j redis：MultiRedis（datasource main）；传递引入 redisson-spring-boot-starter，
             Boot/Redisson 自带自动装配在启动类排除（thmp S0#7 教训） -->
        <dependency>
            <groupId>com.github.funcommons.framework4j</groupId>
            <artifactId>framework4j-redis</artifactId>
            <version>${framework4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Groovy 脚本引擎（05_脚本引擎规格：显式依赖，沙箱） -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>${groovy.version}</version>
        </dependency>
        <!-- fwk4j-web GlobalExceptionHandler 引用 spring-jdbc/dao 异常类型但未声明依赖（v1.5.1 打包遗漏），
             token-route 无数据源，仅补齐以满足反射内省；待 fwk4j 上游修 pom 后移除（issue 候选） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers：Redis IT（07 §1：1.20.6 与 Docker Desktop 29 不兼容，锁 1.21.4） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- docker.io 不可达：禁用 Ryuk 守护容器（@Container 生命周期由 JUnit 管理） -->
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
